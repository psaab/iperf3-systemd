service iperf3-5200
{
    type            = UNLISTED
    port            = 5200
    socket_type     = stream
    protocol        = tcp
    wait            = yes
    user            = root
    server          = /usr/bin/iperf3
    server_args     = --inetd --logfile /var/log/iperf3-5200.log
    log_type        = SYSLOG daemon debug
    log_on_success  = HOST PID EXIT DURATION
    log_on_failure  = HOST ATTEMPT
    disable         = no
    rlimit_files    = 1024
}

