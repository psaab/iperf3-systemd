#!/bin/sh
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
  for p in 5200 5201 5202 5203 5204 5205 5206 5207 5208 5209 5210 5211 5212; do
    systemctl disable --now "iperf3@${p}.socket" "iperf3@${p}.service" >/dev/null 2>&1 || true
  done
  systemctl daemon-reload || true
fi
exit 0
